# ==============================================================================
# Industrial Motor Health Monitoring Platform — Environment Configuration
# Project: industrial-motor-health-monitor (ISOLATED PROJECT)
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# Public Supabase URL for client-side API requests
NEXT_PUBLIC_SUPABASE_URL=https://your-new-project-id.supabase.co

# Public Supabase Anon / Publishable Key (safe for browser bundles)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Server-only Supabase Service Role Secret Key (Privileged DB ingestion)
# NEVER expose this key in client-side code, git, or firmware
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Dedicated Device Ingestion Authentication Token
# ESP32-S3 must include this token in the 'x-device-token' header or Authorization header
# Min 32 characters recommended for production
DEVICE_INGEST_TOKEN=secret_device_token_change_in_production_motor_001

# Public Base URL of this Next.js deployment
NEXT_PUBLIC_APP_URL=https://industrial-motor-health-monitor.vercel.app

# Optional: Demo/Mock Database fallback (set to 'true' for local testing without Supabase credentials)
# In production, ensure this is unset or 'false'
ENABLE_MOCK_FALLBACK=true
